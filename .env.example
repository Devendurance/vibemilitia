# Frontend build-time configuration
# The browser connects to this URL for both Colyseus WebSockets and guest APIs.
NEXT_PUBLIC_GAME_SERVER_URL=https://game.example.com

# Game server runtime
NODE_ENV=production
PORT=2567
ALLOWED_ORIGINS=https://play.example.com
PUBLIC_GAME_SERVER_URL=https://game.example.com
RECONNECT_GRACE_SECONDS=20
MATCH_COUNTDOWN_MS=10000
XP_MIN_PARTICIPATION_MS=45000
TRUST_PROXY=1

# PostgreSQL (preferred). Use the pooled Neon connection string.
# When DATABASE_URL is absent or blank, the server falls back to SQLite.
DATABASE_URL=
DATABASE_SSL=1
DATABASE_POOL_MAX=8

# SQLite fallback only.
DATABASE_PATH=/data/vibe-militia.sqlite

# Test-only. Never enable in production.
# VIBE_MILITIA_TEST_HOOKS=1
# TEST_DATABASE_URL=postgresql://user:password@host/db?sslmode=require
